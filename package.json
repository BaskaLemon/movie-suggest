{
  "name": "movie-suggest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/migrate.mjs && next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "node scripts/migrate.mjs && next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "DATABASE_URL=file:./prisma/dev.db prisma migrate dev",
    "db:deploy": "node scripts/migrate.mjs",
    "db:studio": "url=$(node scripts/studio-url.mjs) && prisma studio --url \"$url\""
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@next/env": "16.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
